# Disc images and large ROM binaries
*.chd
*.bin
*.cue
*.iso
*.img

# Large extracted disc assets
extracted/*.APF
extracted/*.DAT
extracted/*.DA
extracted/*.08
extracted/*.apf_unpacked/
extracted/op_unpacked/
extracted/op2_unpacked/
extracted/textures/
extracted/STR/
extracted/*.rebuilt
build/SLPS*
build/*.chd

# Build outputs (keep patch files, ignore huge disc binaries)
build/*.bin
build/*.cue
build/*.APF
build/*.DAT

# Python cache
__pycache__/
*.py[cod]
*$py.class
